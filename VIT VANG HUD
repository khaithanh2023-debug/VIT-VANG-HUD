        HitboxSize = 2,
        InfiniteJump = false
    }

    -- INFINITE JUMP
    UserInputService.JumpRequest:Connect(function()
        if getgenv().UmlagiSpeedEngine.InfiniteJump then
            local Character = LocalPlayer.Character
            if Character then
                local Humanoid = Character:FindFirstChildOfClass("Humanoid")
                if Humanoid then
                    Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end
    end)

    -- ENGINE LOGIC
    pcall(function()
        settings().Physics.PhysicsEnvironmentalThrottle = 1
        game:GetService("Lighting").GlobalShadows = false 
        task.spawn(function()
            while task.wait(5) do collectgarbage("collect") end
        end)
    end)

    RunService.Heartbeat:Connect(function()
        pcall(function()
            local Character = LocalPlayer.Character
            if not Character then return end
            
            if getgenv().UmlagiSpeedEngine.Noclip then
                for _, child in pairs(Character:GetDescendants()) do
                    if child:IsA("BasePart") and child.CanCollide == true then
                        child.CanCollide = false
                    end
                end
            end

            local Humanoid = Character:FindFirstChildOfClass("Humanoid")
            if Humanoid then
                if Humanoid.UseJumpPower then
                    if Humanoid.JumpPower ~= getgenv().UmlagiSpeedEngine.JumpPower then 
                        Humanoid.JumpPower = getgenv().UmlagiSpeedEngine.JumpPower 
                    end
                else
                    local targetHeight = (getgenv().UmlagiSpeedEngine.JumpPower == 50) and 7.2 or (getgenv().UmlagiSpeedEngine.JumpPower * 0.144)
                    if Humanoid.JumpHeight ~= targetHeight then 
                        Humanoid.JumpHeight = targetHeight 
                    end
                end
            end

            local currentSize = getgenv().UmlagiSpeedEngine.HitboxSize
            if currentSize and currentSize > 2 then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = p.Character.HumanoidRootPart
                        hrp.Size = Vector3.new(currentSize, currentSize, currentSize)
                        hrp.Transparency = 0.7 
                        hrp.Color = Color3.fromRGB(0, 230, 255) 
                        hrp.CanCollide = false 
                    end
                end
            end
        end)
    end)

