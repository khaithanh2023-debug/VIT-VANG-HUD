    GetKeyBtn.Font = Enum.Font.GothamBold
    GetKeyBtn.TextSize = 11
    Instance.new("UICorner", GetKeyBtn).CornerRadius = UDim.new(0, 8)

    GetKeyBtn.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard(GET_KEY_LINK)
            StatusLabel.Text = "🟢 Đã copy Link lấy Key vào bộ nhớ tạm!"
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
        else
            StatusLabel.Text = "❌ Executor không hỗ trợ copy tự động!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
        end
    end)

    -- BẮT SỰ KIỆN XÁC NHẬN KEY
    SubmitBtn.MouseButton1Click:Connect(function()
        if KeyInput.Text == CORRECT_KEY then
            -- TỰ ĐỘNG LƯU KEY VÀO BỘ NHỚ MÁY
            if writefile then
                writefile(KEY_FILE_NAME, CORRECT_KEY)
            end

            StatusLabel.Text = "🟢 Key Chính Xác! Đã lưu Key và mở Hub..."
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
            task.wait(1)
            LoadMainHub()
        else
            wrongAttempts = wrongAttempts + 1
            local remainingAttempts = MAX_ATTEMPTS - wrongAttempts

            if remainingAttempts > 0 then
                StatusLabel.Text = string.format("❌ Key Sai! Còn lại %d/%d lần thử.", remainingAttempts, MAX_ATTEMPTS)
                StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
            else
                StatusLabel.Text = "🚫 Nhập sai quá 5 lần! Đang kích khỏi game..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                task.wait(1.5)
                LocalPlayer:Kick("\n[VỊT VÀNG HUB]\nBạn đã nhập sai Key quá 5 lần!")
            end
        end
    end)
